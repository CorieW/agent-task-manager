{
  "name": "agent-task-manager",
  "version": "0.1.0",
  "description": "Provider-neutral orchestration for task-driven AI sub-agents",
  "type": "module",
  "private": true,
  "bin": {
    "agent-task-manager": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm test",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
