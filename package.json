{
  "name": "@corie_w/agent-task-manager",
  "version": "0.1.0",
  "description": "Provider-agnostic control boundary between an AI-agent harness and a task provider",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CorieW/agent-task-manager.git"
  },
  "bugs": {
    "url": "https://github.com/CorieW/agent-task-manager/issues"
  },
  "homepage": "https://github.com/CorieW/agent-task-manager#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "agent-task-manager": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./providers/notion": "./dist/src/provider/notion/index.js"
  },
  "files": [
    "dist/src",
    "docs",
    "agent-task-manager.environment.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm pack:check",
    "format": "prettier --config config/prettier.config.js --ignore-path .gitignore --ignore-path config/.prettierignore --write .",
    "format:check": "prettier --config config/prettier.config.js --ignore-path .gitignore --ignore-path config/.prettierignore --check .",
    "lint": "eslint --config config/eslint.config.js .",
    "lint:fix": "eslint --config config/eslint.config.js . --fix",
    "knip": "knip --tsConfig config/tsconfig.json",
    "pack:check": "pnpm build && npm pack --dry-run",
    "release": "changeset publish",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p config/tsconfig.json --noEmit",
    "version-packages": "changeset version"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.3",
    "eslint": "^10.9.0",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
